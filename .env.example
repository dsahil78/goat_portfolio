# Optional: defaults to the intended production domain.
SITE_URL=https://duasahil.com
# Local SEO audits only. Vercel uses VERCEL_ENV automatically.
# Preview deployments always remain noindex, even if this value is true.
SITE_INDEXABLE=false
# Public PostHog project key (US region). Empty disables all analytics.
NEXT_PUBLIC_POSTHOG_KEY=
